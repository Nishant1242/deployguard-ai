APP_NAME="DeployGuard AI API"
APP_VERSION="0.2.0"
ENVIRONMENT="development"
DEBUG=true

DATABASE_URL="postgresql+psycopg://deployguard:replace-with-local-password@localhost:5432/deployguard"
TEST_DATABASE_URL="postgresql+psycopg://deployguard:replace-with-local-password@localhost:5432/deployguard_test"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
